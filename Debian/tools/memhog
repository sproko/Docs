#!/bin/sh
# Biggest memory users (RAM + swap) from atop's history, each at its own peak.
# usage: memhog [YYYYMMDD] [from HH:MM] [to HH:MM] [count]
#   memhog                       today, whole day, top 15
#   memhog 20261025 00:00 00:30  just before a crash
day=${1:-$(date +%Y%m%d)}
from=${2:-00:00}
to=${3:-23:59}
n=${4:-15}
log=/var/log/atop/atop_$day
[ -r "$log" ] || { echo "no atop log for $day ($log)" >&2; exit 1; }

# PRM has the sizes, PRG the full command line; join them on sample time + pid.
# Sizes are KiB: PRM $12 = resident, $21 = swap; $23 = y marks a process, not a thread.
atop -r "$log" -b "$from" -e "$to" -P PRM,PRG 2>/dev/null | awk -v n="$n" '
$1 == "PRM" && $23 == "y" { k = $3 " " $7; mem[k] = $12 + $21; rss[k] = $12; swp[k] = $21; at[k] = $5; pid[k] = $7; name[k] = $8 }
$1 == "PRG" {
    rest = $0
    for (i = 1; i <= 15; i++) sub(/^[^ ]+ /, "", rest)
    # Thread rows share the pid but carry an empty "()" command; do not let them overwrite.
    if (match(rest, /\) [0-9]+ [0-9]+ [0-9]+ /) && RSTART > 2) cmd[$3 " " $7] = substr(rest, 2, RSTART - 2)
}
END {
    for (k in mem) {
        p = pid[k]
        if (mem[k] > peak[p]) { peak[p] = mem[k]; pk[p] = k }
    }
    for (p in peak) {
        k = pk[p]; c = (cmd[k] != "") ? cmd[k] : name[k]
        printf "%d\t%s\t%7.1fG %7.1fG %7.1fG  %-7s %s\n", peak[p], at[k], mem[k]/1048576, rss[k]/1048576, swp[k]/1048576, p, substr(c, 1, 90)
    }
}' | sort -rn | head -n "$n" | cut -f2- | {
    printf '%-8s %8s %8s %8s  %-7s %s\n' PEAK-AT TOTAL RAM SWAP PID COMMAND
    tr '\t' ' '
}
