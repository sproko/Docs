#!/bin/sh
# Download the newest release of each upstream tool that Debian doesn't ship
# (or ships too old for LazyVim) into <dir>, each checked against the SHA-256
# GitHub publishes for it. Used by build-iso.sh and bootstrap.sh.
#
#   fetch-upstream <dir>

set -eu

dir="$1"
mkdir -p "$dir"

# fetch <owner/repo> <asset>: newest release's asset, verified, into $dir
fetch() {
    release="$(curl -fsSL --retry 3 --connect-timeout 10 --max-time 30 \
        "https://api.github.com/repos/$1/releases/latest")"
    # In the API's JSON each asset lists "name", then "digest", then
    # "browser_download_url"
    set -- "$1" "$2" $(printf '%s\n' "$release" | awk -v asset="\"$2\"" '
        /"tag_name":/ && !tag { gsub(/[",]/, "", $2); tag = $2 }
        /"name":/ && index($0, asset) { found = 1 }
        found && /"digest":/ { gsub(/[",]/, "", $2); sub(/^sha256:/, "", $2); sha = $2 }
        found && /"browser_download_url":/ { gsub(/[",]/, "", $2); print tag, sha, $2; exit }')
    [ "$#" -eq 5 ] && [ "${#4}" -eq 64 ] || { echo "$1: no $2 with a checksum in the latest release." >&2; return 1; }
    curl -fsSL --retry 3 -o "$dir/$2" "$5"
    echo "$4  $dir/$2" | sha256sum -c --quiet - || { echo "$1 $3: checksum mismatch." >&2; rm -f "$dir/$2"; return 1; }
    echo "$1 $3"
}

fetch neovim/neovim nvim-linux-x86_64.tar.gz
fetch tree-sitter/tree-sitter tree-sitter-linux-x64.gz
fetch herdrdev/herdr herdr-linux-x86_64
